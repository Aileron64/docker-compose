#!/bin/bash

# Check docker installation
if command -v docker --version &> /dev/null; then
    echo -e "\033[32m =================== docker installation present                           ==================="
else
    echo -e "\033[31m =================== docker installation not present                       ==================="
    exit 1
fi

# Check docker-compose installation
if command -v docker-compose --version &> /dev/null; then
    echo -e "\033[32m =================== docker-compose installation present                   ==================="
else
    echo -e "\033[31m =================== docker-compose installation not present               ==================="
    exit 1
fi

# Check envsubst installation
if command -v envsubst --version &> /dev/null; then
    echo -e "\033[32m =================== envsubst installation present                         ==================="
else
    echo -e "\033[31m =================== envsubst installation not present                     ==================="
    exit 1
fi

# Check dig installation
if command -v dig -v &> /dev/null; then
    echo -e "\033[32m =================== dig installation present                              ==================="
else
    echo -e "\033[31m =================== dig installation not present                          ==================="
    exit 1
fi

# Check dig installation
if command -v aws --version &> /dev/null; then
    echo -e "\033[32m =================== aws installation present                              ==================="
else
    echo -e "\033[31m =================== aws installation not present                          ==================="
    exit 1
fi

# Check if certificate is present
if [ -f "configs/nginx/cert/certificate.crt" ]; then
    echo -e "\033[32m =================== certificate.crt is present at configs/nginx/cert/     ==================="
else
    echo -e "\033[31m =================== certificate.crt not present at configs/nginx/cert/    ==================="
    exit 1
fi

# Check if key is present
if [ -f "configs/nginx/cert/key.key" ]; then
    echo -e "\033[32m =================== key.key is present at configs/nginx/cert/             ==================="
else
    echo -e "\033[31m =================== key.key not present at configs/nginx/cert/            ==================="
    exit 1
fi

is_database_ready() {
    if [ $(docker inspect --format='{{.State.Health.Status}}' "postgres" 2>/dev/null) == "healthy" ]; then
        return 0
    else
        return 1
    fi
}

docker login -u AWS -p $(aws ecr get-login-password --region us-east-2) 782111260328.dkr.ecr.us-east-2.amazonaws.com

# Sometime .env file is not recognized file by docker compose so it becomes necessary to go inside compose folder and then run
cd compose

# Run only database to create keycloak schema. 
# Ideally it should be part of postgres container entrypoint but somehow its not working since its custom postgres image. Need to figure that out
docker-compose -f docker-compose-combined.yml up -d postgresql

# Wait until the container is healthy
while ! is_database_ready; do
    echo "Database container is not healthy yet, waiting..."
    sleep 1 
done

# Create keycloak schema if it does not already exists
docker exec  postgres psql "postgresql://$POSTGRES_USERNAME:$POSTGRES_PASSWORD@localhost:5432/$POSTGRES_DB" -c "CREATE SCHEMA IF NOT EXISTS $KEYCLOAK_SCHEMA AUTHORIZATION $POSTGRES_USERNAME;"

# Run all the containers now
SV_HOST_IP="$(dig +short $SV_HOSTNAME)" docker-compose -f docker-compose-combined.yml up -d